{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "opencode",
    "openrouter",
    "nvidia-nim",
    "minimax-coding-plan",
    "ollama",
    "9router"
  ],
  "model": "9router/smart",
  "small_model": "9router/fast",

  "agent": {
	"plan": {
	  "model": "9router/smart",
	  "temperature": 0.1,
	  "description": "Cria o plano detalhado (contexto longo, raciocínio forte via combo smart: Gemini 3.1 Pro → DeepSeek V4 Pro → GLM 5.2 → Kimi K2 Thinking → GPT-OSS-120B → MiniMax M3)"
	},
    "build": {
      "model": "9router/coder",
	  "temperature": 0.2,
	  "description": "Implementa o código (Round Robin entre Seed 2.0 Code → GLM 4.7 → GLM 5 → DeepSeek V4 Flash → MiniMax M2.7 → MiniMax M2.5). Sem poluição de reasoning."
    },
    "review": {
      "model": "9router/smart",
	  "temperature": 0.1,
	  "description": "REVISÃO OBRIGATÓRIA: combo smart com contexto longo e raciocínio profundo (Gemini 3.1 Pro, DeepSeek V4 Pro, GLM 5.2, Kimi K2 Thinking)"
    },
    "bugfix": {
      "model": "9router/smart",
	  "temperature": 0.1,
	  "description": "Corrige bugs apontados pelo review/test (combo smart: reasoning forte + fallback automático entre Gemini Pro, DeepSeek Pro, GLM 5.2, Kimi, GPT-OSS)"
    }
  },

  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{file:./.env.9router}"
      },
      "whitelist": [
        "fast",
        "smart",
        "vision",
        "coder"
      ],
      "models": {
        "fast": {
          "name": "9Router Combo: fast (Fallback)",
          "description": "Combos de baixa latência: Gemini 2.5 Flash Lite → Gemini 3.1 Flash Lite → GLM 4.7 Flash → DeepSeek V4 Flash → GPT OSS 120B → MiMo Auto"
        },
        "smart": {
          "name": "9Router Combo: smart (Fallback)",
          "description": "Combos de raciocínio forte: Gemini 3.1 Pro → DeepSeek V4 Pro → GLM 5.2 → Kimi K2 Thinking → GPT-OSS-120B → MiniMax M3"
        },
        "vision": {
          "name": "9Router Combo: vision (Fallback auto-switch)",
          "description": "Combos com suporte a imagem/PDF/áudio: Gemini 3.1 Pro → Kimi K2 Thinking → MiniMax M3 → Kimi K2.5 → Qwen3.5 → MiMo Auto"
        },
        "coder": {
          "name": "9Router Combo: coder (Round Robin)",
          "description": "Combos de código distribuído: Seed 2.0 Code → GLM 4.7 → GLM 5 → DeepSeek V4 Flash → MiniMax M2.7 → MiniMax M2.5"
        }
      }
    },
	"minimax-coding-plan": {
	  "npm": "@ai-sdk/openai-compatible",
	  "options": {
		"baseURL": "https://api.minimax.io/v1",
		"apiKey": "{env:MINIMAX_API_KEY}"
	  },
      "whitelist": [
        "MiniMax-M3"
      ],
      "models": {
        "MiniMax-M3": {
          "name": "MiniMax M3 (direto)",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    },
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
      },
      "whitelist": [
        "minimax-m3",
        "deepseek-v4-flash-free",
        "mimo-v2.5-free",
        "north-mini-code-free",
        "nemotron-3-ultra-free"
      ],
      "models": {
        "minimax-m3": { "name": "MiniMax M3" },
        "deepseek-v4-flash-free": { "name": "DeepSeek V4 Flash Free" },
        "mimo-v2.5-free": { "name": "MiMo V2.5 Free" },
        "north-mini-code-free": { "name": "North Mini Code Free" }
      }
    },
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "whitelist": [
        "nomic-embed-text:latest"
      ],
      "models": {
        "nomic-embed-text:latest": {
          "name": "nomic-embed-text:latest",
          "limit": {
            "context": 32768,
            "output": 32768
          }
        }
      }
    },
	"openrouter": {
	  "npm": "@ai-sdk/openai-compatible",
	  "options": {
		"baseURL": "https://openrouter.ai/api/v1",
		"apiKey": "{env:OPENROUTER_API_KEY}"
	  },
	  "whitelist": [
		"cohere/north-mini-code:free",
		"deepseek/deepseek-v3.1:free",
		"poolside/laguna-s-2.1:free",
		"inclusionai/ling-3.0-flash:free"
	  ],
	  "models": {
		"cohere/north-mini-code:free": { "name": "Cohere North Mini Code Free" },
		"deepseek/deepseek-v3.1:free": { "name": "DeepSeek V3.1 Free" },
		"poolside/laguna-s-2.1:free": { "name": "Poolside Laguna S 2.1 (free)" },
		"inclusionai/ling-3.0-flash:free": { "name": "Ling-3.0-flash (free)" }
	  }
	},
    "nvidia-nim": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_NIM_API_KEY}"
      },
      "whitelist": [
        "nvidia/nemotron-3-ultra-550b-a55b"
      ],
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550b a55b (NVIDIA)"
        }
      }
    }
  },

  "lsp": {
    "typescript": {
      "command": ["npx", "-y", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    },
    "python": {
      "command": ["uvx", "pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },

  "mcp": {
    "mcp-igniter": {
      "type": "local",
      "command": ["node", "C:/nvm4w/nodejs/node_modules/@igniter-js/mcp-server/dist/index.js"],
      "enabled": true,
      "timeout": 60000
    },
    "memory": {
      "type": "local",
      "command": ["node", "C:/nvm4w/nodejs/node_modules/@modelcontextprotocol/server-memory/dist/index.js"],
      "enabled": true,
      "timeout": 60000
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["node", "C:/nvm4w/nodejs/node_modules/@modelcontextprotocol/server-sequential-thinking/dist/index.js"],
      "enabled": true,
      "timeout": 60000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": { 
        "Authorization": "Bearer {env:GITHUB_API_KEY}"
      }
    },	
    "opencode-rag": {
      "type": "local",
      "command": [
        "node",
        "D:/cloudpilot-deploy/.opencode/node_modules/opencode-rag-plugin/dist/cli.js",
        "mcp",
        "--config",
        "D:/cloudpilot-deploy/.opencode/opencode-rag.json"
      ],
      "environment": {
        "OPENCODE_RAG_CWD": "D:/cloudpilot-deploy/.opencode"
      },
      "enabled": true,
      "timeout": 60000
    },
    "jira": {
      "type": "local",
      "command": ["node", "C:/nvm4w/nodejs/node_modules/jira-server/build/index.js"],
      "environment": {
        "JIRA_URL": "https://edsonfcunha68.atlassian.net",
        "JIRA_EMAIL": "edsonfcunha68@gmail.com",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      },
      "enabled": true,
      "timeout": 60000
    },
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": true,
      "timeout": 60000
    },
    "pencil": {
      "type": "local",
      "command": [
        "C:\\Users\\ECUNHA\\.pencil\\mcp\\kiro\\out\\mcp-server-windows-x64.exe",
        "--app",
        "kiro"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "./.opencode/plugins/rag-plugin.js"
  ],
  "skills": {
    "paths": [
      "D:/archify/archify"
    ]
  }
}