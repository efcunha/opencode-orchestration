{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "minimax-coding-plan",
    "deepseek",
    "ollama"
  ],
  "model": "minimax-coding-plan/MiniMax-M3",
  "small_model": "deepseek/deepseek-v4-flash-free",
  "agent": {
    "plan": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.1,
      "description": "Planejamento e arquitetura via DeepSeek V4 Pro (opencode-zen)."
    },
    "build": {
      "model": "minimax-coding-plan/MiniMax-M3",
      "temperature": 0.2,
      "description": "Implementacao de codigo via MiniMax M3 (direto)."
    },
    "review": {
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.1,
      "description": "Revisao independente via DeepSeek V4 Flash Free — linhagem de modelo diferente do executor (MiniMax M3), evita autoavaliacao."
    },
    "bugfix": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.15,
      "description": "Diagnostico e correcao de bugs via DeepSeek V4 Pro (opencode-zen)."
    }
  },
  "provider": {
    "minimax-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.minimax.io/v1",
        "apiKey": "{env:MINIMAX_API_KEY}"
      },
      "whitelist": ["MiniMax-M3"],
      "models": {
        "MiniMax-M3": {
          "name": "MiniMax M3 (direto)",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "whitelist": [
        "deepseek-v4-flash",
        "deepseek-v4-flash-free",
        "deepseek-v4-pro"
      ],
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": { "context": 1000000, "output": 384000 }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": { "context": 1000000, "output": 384000 }
        }
      }
    },
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "whitelist": ["nomic-embed-text:latest"],
      "models": {
        "nomic-embed-text:latest": {
          "name": "nomic-embed-text:latest",
          "limit": { "context": 32768, "output": 32768 }
        }
      }
    }
  },
  "lsp": {
    "typescript": {
      "command": ["npx", "-y", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    },
    "python": {
      "command": ["uvx", "pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "mcp": {
    "mcp-igniter": {
      "type": "local",
      "command": ["node", "C:/nvm4w/nodejs/node_modules/@igniter-js/mcp-server/dist/index.js"],
      "enabled": true,
      "timeout": 60000
    },
    "memory": {
      "type": "local",
      "command": ["node", "C:/nvm4w/nodejs/node_modules/@modelcontextprotocol/server-memory/dist/index.js"],
      "enabled": true,
      "timeout": 60000
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["node", "C:/nvm4w/nodejs/node_modules/@modelcontextprotocol/server-sequential-thinking/dist/index.js"],
      "enabled": true,
      "timeout": 60000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" },
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_API_KEY}" },
      "enabled": true,
      "timeout": 60000
    },
    "opencode-rag": {
      "type": "local",
      "command": ["node", "D:/cloudpilot-deploy/.opencode/node_modules/opencode-rag-plugin/dist/cli.js", "mcp", "--config", "D:/cloudpilot-deploy/.opencode/opencode-rag.json"],
      "environment": { "OPENCODE_RAG_CWD": "D:/cloudpilot-deploy/.opencode" },
      "enabled": true,
      "timeout": 60000
    },
    "jira": {
      "type": "local",
      "command": ["node", "C:/nvm4w/nodejs/node_modules/jira-server/build/index.js"],
      "environment": {
        "JIRA_URL": "https://edsonfcunha68.atlassian.net",
        "JIRA_EMAIL": "edsonfcunha68@gmail.com",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      },
      "enabled": true,
      "timeout": 60000
    },
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": true,
      "timeout": 60000
    },
    "pencil": {
      "type": "local",
      "command": ["C:\\Users\\ECUNHA\\.pencil\\mcp\\kiro\\out\\mcp-server-windows-x64.exe", "--app", "kiro"],
      "enabled": true
    },
    "code-review-graph": {
      "type": "local",
      "command": ["uvx", "code-review-graph", "serve", "--repo", "D:\\cloudpilot-deploy"],
      "enabled": true,
      "timeout": 60000
    }
  },
  "plugin": [
    "./.opencode/plugins/rag-plugin.js",
    "@statista-oss/opencode-workflow"
  ],
  "skills": {
    "paths": [
      "D:/archify/archify"
    ]
  }
}