{
  "$schema": "https://opencode.ai/config.json",
  // ─────────────────────────────────────────────────────────────────────────
  // TEMPLATE — tres grupos de placeholders sao resolvidos na instalacao
  // (scripts/Install-Orchestration.ps1):
  //
  //   {{nodeModules}}, {{userHome}}, {{userAgents}}
  //       Paths de maquina resolvidos via `npm root -g`, $env:USERPROFILE
  //       e $HOME. Usados nos caminhos de MCPs npm.
  //
  //   {{...Model}}, {{...ModelDefault}}, {{enabledProvidersList}}, {{providersBlock}}
  //       Configuracao de LLMs/providers. Fontes (em ordem de prioridade):
  //         1. config/llm-providers.json (gitignored, override do usuario)
  //         2. scripts/llm-defaults.json (default do orquestrador)
  //       Para adicionar/trocar providers, copie
  //       scripts/llm-defaults.json para config/llm-providers.json e edite.
  //       Nenhuma string de provider/modelo fica hardcoded aqui.
  //
  //   {{opencodeProviderDescription(<slot>)}}
  //       Texto descritivo por slot de agente. Hoje vem dos defaults; o
  //       usuario pode sobrescrever via config/llm-providers.json em
  //       agents.<slot>.description.
  // ─────────────────────────────────────────────────────────────────────────

  "enabled_providers": {{enabledProvidersList}},

  "model": "{{modelDefault}}",
  "small_model": "{{smallModelDefault}}",

  "agent": {
    "plan": {
      "model": "{{modelAgentPlan}}",
      "temperature": {{tempAgentPlan}},
      "description": "{{descAgentPlan}}"
    },
    "build": {
      "model": "{{modelAgentBuild}}",
      "temperature": {{tempAgentBuild}},
      "description": "{{descAgentBuild}}"
    },
    "review": {
      "model": "{{modelAgentReview}}",
      "temperature": {{tempAgentReview}},
      "description": "{{descAgentReview}}"
    },
    "bugfix": {
      "model": "{{modelAgentBugfix}}",
      "temperature": {{tempAgentBugfix}},
      "description": "{{descAgentBugfix}}"
    },
    "general": {
      "model": "{{modelAgentGeneral}}",
      "temperature": {{tempAgentGeneral}},
      "description": "{{descAgentGeneral}}"
    },
    "explore": {
      "model": "{{modelAgentExplore}}",
      "temperature": {{tempAgentExplore}},
      "description": "{{descAgentExplore}}"
    }
  },

  "provider": {{providersBlock}},

  "lsp": {
    "typescript": {
      "command": ["npx", "-y", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    },
    "python": {
      "command": ["uvx", "pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },

  // MCPs dividem-se em tres grupos:
  //   - binarios npm: instalados pelo pacote (veja scripts/mcp-packages.json).
  //     Caminho resolvido via `npm root -g` no install.
  //   - npx: rodados sob demanda. Sem state global. Nao precisam de install.
  //   - binarios externos (uvx/CLI): exigem o binario no PATH,
  //     declarado opcionalmente em Install-Orchestration.ps1.
  // enabled:true significa "disponivel", nao "funcionando" - sem os devidos
  // binarios ou env vars o servidor MCP sobe vazio ou falha na primeira chamada.
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "node",
        "{{nodeModules}}/@modelcontextprotocol/server-sequential-thinking/dist/index.js"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "memory": {
      "type": "local",
      "command": [
        "node",
        "{{nodeModules}}/@modelcontextprotocol/server-memory/dist/index.js"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    }
  },

  "plugin": [
    "plugins/opencode-quests.ts",
    "plugins/crg-plugin.ts"
  ],

  "skills": {
    "paths": [
      "skills/archify"
    ]
  }
}
