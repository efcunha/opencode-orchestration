{
  "$schema": "https://opencode.ai/config.json",
  // ─────────────────────────────────────────────────────────────────────────
  // Configuracao GLOBAL do opencode — providers e agentes para TODOS os projetos.
  //
  // Consolidada em 2026-08-18. Antes disto cada projeto declarava seus proprios
  // providers e agentes, o que fazia `agent: plan` significar modelos diferentes
  // em cada repo (deepseek-v4-pro no cloudpilot, 9router/smart no ameg,
  // nvidia-nim/nemotron no cip) e quebrava quest com roteamento por estagio.
  //
  // Precedencia do opencode: user (este arquivo) < workspace (opencode.json do
  // projeto). Projeto ainda pode sobrepor quando precisar.
  //
  // O que NAO vem para ca, e por que:
  //   mcp          → entradas com caminho absoluto por projeto (opencode-rag)
  //   plugin       → caminho relativo ./.opencode/plugins/
  //   lsp, skills  → dependem da arvore do projeto
  // ─────────────────────────────────────────────────────────────────────────

  "enabled_providers": [
    "minimax-coding-plan",
    "deepseek",
    "ollama"
  ],

  "model": "minimax-coding-plan/MiniMax-M3",
  "small_model": "deepseek/deepseek-v4-flash",

  "agent": {
    // Agentes primarios. plan e build sao slots NATIVOS do opencode — alternados
    // com Tab no TUI. Sobrescrever aqui reconfigura os embutidos.
    "plan": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.1,
      "description": "Planejamento, arquitetura e reproducao de defeito via DeepSeek V4 Pro."
    },
    "build": {
      "model": "minimax-coding-plan/MiniMax-M3",
      "temperature": 0.2,
      "description": "Implementacao de codigo via MiniMax M3 (API direta)."
    },
    "review": {
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.1,
      "description": "Revisao independente via DeepSeek V4 Flash — linhagem diferente do executor (MiniMax M3), reduz autoavaliacao."
    },
    "bugfix": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.15,
      "description": "Diagnostico e correcao de bugs via DeepSeek V4 Pro."
    },

    // Slots de SUBAGENTE. Sem model declarado eles herdavam o default raiz, ou
    // seja: toda delegacao (exploracao de codigo, research amplo) ia para o
    // MiniMax M3. Este e o unico roteamento verdadeiramente automatico que
    // existe aqui — o primario decide delegar, o slot decide o modelo.
    // Para reverter ao comportamento anterior, remova os dois blocos abaixo.
    "general": {
      "model": "deepseek/deepseek-v4-flash",
      "description": "Subagente de proposito geral. Modelo barato de proposito: delegacao e volumosa."
    },
    "explore": {
      "model": "deepseek/deepseek-v4-flash",
      "description": "Subagente de exploracao de codigo. Volume alto, julgamento baixo."
    }
  },

  "provider": {
    "minimax-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.minimax.io/v1",
        "apiKey": "{env:MINIMAX_API_KEY}"
      },
      "whitelist": ["MiniMax-M3"],
      "models": {
        "MiniMax-M3": {
          "name": "MiniMax M3 (direto)",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "whitelist": [
        "deepseek-v4-flash",
        "deepseek-v4-pro"
      ],
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": { "context": 1000000, "output": 384000 }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": { "context": 1000000, "output": 384000 }
        }
      }
    },
    // Local, usado pelo opencode-rag para embeddings (nomic-embed-text).
    // Porta 11434 verificada no ar em 2026-08-18.
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "whitelist": ["nomic-embed-text:latest"],
      "models": {
        "nomic-embed-text:latest": {
          "name": "nomic-embed-text:latest",
          "limit": { "context": 32768, "output": 32768 }
        }
      }
    }
  }
}
