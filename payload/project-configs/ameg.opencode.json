{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "command": [
        "npx",
        "-y",
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    },
    "python": {
      "command": [
        "uvx",
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "mcp": {
    "mcp-igniter": {
      "type": "local",
      "command": [
        "node",
        "C:/nvm4w/nodejs/node_modules/@igniter-js/mcp-server/dist/index.js"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "memory": {
      "type": "local",
      "command": [
        "node",
        "C:/nvm4w/nodejs/node_modules/@modelcontextprotocol/server-memory/dist/index.js"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "node",
        "C:/nvm4w/nodejs/node_modules/@modelcontextprotocol/server-sequential-thinking/dist/index.js"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_API_KEY}"
      }
    },
    "opencode-rag": {
      "type": "local",
      "command": [
        "node",
        "D:/cloudpilot-deploy/.opencode/node_modules/opencode-rag-plugin/dist/cli.js",
        "mcp",
        "--config",
        "D:/cloudpilot-deploy/.opencode/opencode-rag.json"
      ],
      "environment": {
        "OPENCODE_RAG_CWD": "D:/cloudpilot-deploy/.opencode"
      },
      "enabled": true,
      "timeout": 60000
    },
    "jira": {
      "type": "local",
      "command": [
        "node",
        "C:/nvm4w/nodejs/node_modules/jira-server/build/index.js"
      ],
      "environment": {
        "JIRA_URL": "https://edsonfcunha68.atlassian.net",
        "JIRA_EMAIL": "edsonfcunha68@gmail.com",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      },
      "enabled": true,
      "timeout": 60000
    },
    "railway": {
      "type": "local",
      "command": [
        "railway",
        "mcp"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "pencil": {
      "type": "local",
      "command": [
        "C:\\Users\\ECUNHA\\.pencil\\mcp\\kiro\\out\\mcp-server-windows-x64.exe",
        "--app",
        "kiro"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "./.opencode/plugins/rag-plugin.js"
  ],
  "skills": {
    "paths": [
      "D:/archify/archify"
    ]
  }
}
